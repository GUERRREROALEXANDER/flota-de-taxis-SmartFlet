# Copiar a .env (en la raiz del proyecto) y completar con valores reales.
# .env esta en .gitignore: NUNCA subas credenciales al repositorio.
# El backend lee este archivo al arrancar (spring.config.import en application.yml);
# tambien puedes definir las mismas variables como variables de entorno del sistema.

# Cadena de conexion a MongoDB.
# - MongoDB Atlas: copiala desde Atlas > Database > Connect > Drivers y reemplaza <usuario> y <clave>.
#   Si la clave tiene caracteres especiales (@ : / ? # %), escribela codificada (ej. @ -> %40).
# - Sin esta variable, el backend usa MongoDB local: mongodb://localhost:27017/smartflet
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>.<id>.mongodb.net/smartflet?retryWrites=true&w=majority

# Puerto HTTP del backend
SERVER_PORT=8080
